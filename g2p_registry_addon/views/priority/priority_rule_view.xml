<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_priority_rule_definition_form_inherit_dr_registry" model="ir.ui.view">
        <field name="name">g2p.priority.rule.definition.form.inherit.dr.registry</field>
        <field name="model">g2p.priority.rule.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_priority_rule_definition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="inside">
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.youth.registry', 'allowed_fields': ['priority_rank']}"/>
            </xpath>
        </field>
    </record>
</odoo>
