<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_enderase_members_tree" model="ir.ui.view">
        <field name="name">enderase.members.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree decoration-muted="enderase_record_status == 'archived'" decoration-danger="enderase_record_status == 'rejected'">
                <field name="enderase_registry_id"/>
                <field name="name"/>
                <field name="enderase_individual_type_ids" widget="many2many_tags"/>
                <field name="fayda_national_id"/>
                <field name="gender"/>
                <field name="birthdate"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="enderase_admin_region_id"/>
                <field name="enderase_membership_status"/>
                <field name="enderase_record_status"/>
            </tree>
        </field>
    </record>

    <record id="view_enderase_groups_tree" model="ir.ui.view">
        <field name="name">enderase.groups.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree decoration-muted="enderase_record_status == 'archived'" decoration-danger="enderase_record_status == 'rejected'">
                <field name="enderase_registry_id"/>
                <field name="name"/>
                <field name="startup_name"/>
                <field name="enderase_group_type_ids" widget="many2many_tags"/>
                <field name="organization_type"/>
                <field name="representative_role"/>
                <field name="selected_for_showcase"/>
                <field name="interested_in_collaboration"/>
                <field name="hiring_or_recruiting"/>
                <field name="enderase_record_status"/>
            </tree>
        </field>
    </record>

    <record id="view_enderase_registry_search" model="ir.ui.view">
        <field name="name">enderase.registry.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="enderase_registry_id"/>
                <field name="fayda_national_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="startup_name"/>
                <field name="enderase_individual_type_ids"/>
                <field name="enderase_group_type_ids"/>
                <filter name="members" string="Members" domain="[('is_enderase_member', '=', True), ('is_group', '=', False)]"/>
                <filter name="beneficiaries" string="Beneficiaries" domain="[('is_enderase_beneficiary', '=', True)]"/>
                <filter name="startups" string="Startups" domain="[('is_enderase_startup', '=', True), ('is_group', '=', True)]"/>
                <filter name="groups" string="Groups" domain="['&amp;', ('is_group', '=', True), '|', ('is_enderase_group', '=', True), ('is_enderase_startup', '=', True)]"/>
                <filter name="active_records" string="Active" domain="[('enderase_record_status', '=', 'active')]"/>
                <filter name="needs_follow_up" string="Needs Follow-up" domain="[('needs_follow_up', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'enderase_record_status'}"/>
                    <filter name="group_region" string="Region" context="{'group_by': 'enderase_admin_region_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'enderase_beneficiary_category'}"/>
                    <filter name="group_type" string="Group Type" context="{'group_by': 'group_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_enderase_individual_form_inherit" model="ir.ui.view">
        <field name="name">enderase.individual.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="g2p_registry_individual.view_individuals_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header invisible="not is_enderase_member and not is_enderase_beneficiary">
                    <field name="enderase_record_status" widget="statusbar" statusbar_visible="draft,submitted,verified,active"/>
                    <button name="action_enderase_submit" type="object" string="Submit" class="btn-primary" invisible="enderase_record_status != 'draft'"/>
                    <button name="action_enderase_verify" type="object" string="Verify" class="btn-secondary" invisible="enderase_record_status != 'submitted'"/>
                    <button name="action_enderase_activate" type="object" string="Activate" class="btn-success" invisible="enderase_record_status not in ('submitted', 'verified')"/>
                    <button name="action_enderase_reject" type="object" string="Reject" class="btn-danger" invisible="enderase_record_status in ('rejected', 'archived')"/>
                    <button name="action_enderase_archive_registry" type="object" string="Archive Registry" invisible="enderase_record_status == 'archived'"/>
                </header>
            </xpath>
            <xpath expr="//notebook[@name='individual_detail']" position="inside">
                <page string="Enderase Profile" name="enderase_profile" invisible="not is_enderase_member and not is_enderase_beneficiary">
                    <group>
                        <group string="Registry">
                            <field name="enderase_individual_type_ids" widget="many2many_tags"/>
                            <field name="is_enderase_member" readonly="1"/>
                            <field name="is_enderase_beneficiary" readonly="1"/>
                            <field name="enderase_registry_id" readonly="1"/>
                            <field name="enderase_membership_status"/>
                            <field name="enderase_beneficiary_type"/>
                            <field name="source_reference"/>
                            <field name="odk_instance_id"/>
                        </group>
                        <group string="Identity">
                            <field name="enderase_full_name"/>
                            <field name="fayda_national_id"/>
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="enderase_nationality"/>
                        </group>
                    </group>
                    <group string="Administrative Area">
                        <field name="enderase_admin_region_id"/>
                        <field name="enderase_admin_zone_id"/>
                        <field name="enderase_admin_woreda_id"/>
                        <field name="enderase_kebele_name"/>
                        <field name="enderase_subcity_id"/>
                    </group>
                </page>
                <page string="Youth Skills Development" name="youth_skills_development" invisible="not is_enderase_member and not is_enderase_beneficiary">
                    <group string="Youth Skills Development">
                        <group>
                            <field name="occupation_profession_id"/>
                            <field name="profession_other" invisible="occupation_profession_id == False"/>
                            <field name="educational_level_id"/>
                            <field name="employment_status_id"/>
                            <field name="interested_starting_business"/>
                            <field name="business_area_interest" invisible="interested_starting_business != 'yes'"/>
                        </group>
                        <group>
                            <field name="desired_training_area_ids" widget="many2many_tags"/>
                            <field name="training_area_other"/>
                            <field name="preferred_training_schedule_ids" widget="many2many_tags"/>
                            <field name="required_support_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="current_skills"/>
                            <field name="previous_training_received"/>
                            <field name="certifications_held"/>
                        </group>
                    </group>
                </page>
                <page string="Membership" name="enderase_membership" invisible="not is_enderase_member and not is_enderase_beneficiary">
                    <group>
                        <group>
                            <field name="previous_membership"/>
                            <field name="experience_skill_area"/>
                            <field name="reason_for_joining"/>
                            <field name="interest_area_ids" widget="many2many_tags"/>
                            <field name="interest_area_other"/>
                            <field name="membership_type_id"/>
                            <field name="declaration"/>
                        </group>
                        <group>
                            <field name="interested_starting_business"/>
                            <field name="business_area_interest" invisible="interested_starting_business != 'yes'"/>
                            <field name="hear_about_id"/>
                            <field name="hear_about_other" invisible="hear_about_id == False"/>
                        </group>
                    </group>
                    <group>
                        <field name="why_join"/>
                        <field name="career_path"/>
                        <field name="skills_to_develop"/>
                        <field name="challenges_faced"/>
                        <field name="support_ambitions"/>
                        <field name="leadership_growth"/>
                        <field name="view_of_enderase"/>
                        <field name="value_to_members_community"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

