    <record id="action_enderase_individuals" model="ir.actions.act_window">
        <field name="name">Enderase Individuals</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['&amp;', ('is_group', '=', False), '|', ('is_enderase_member', '=', True), ('is_enderase_beneficiary', '=', True)]</field>
        <field name="context" eval="{'default_is_registrant': True, 'default_is_group': False}"/>
        <field name="search_view_id" ref="view_enderase_registry_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_enderase_members_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_enderase_member_form_primary')})]"/>
    </record>

