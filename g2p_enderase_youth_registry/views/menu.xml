        <field name="sequence" eval="3"/>
    </record>

    <record id="g2p_registry_individual.menu_individuals_list" model="ir.ui.menu">
        <field name="name">Individuals</field>
        <field name="parent_id" ref="g2p_registry_base.g2p_main_menu_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_enderase_individuals')"/>
        <field name="sequence" eval="10"/>
        <field name="active" eval="False"/>
    </record>

    <record id="g2p_registry_group.menu_groups_list" model="ir.ui.menu">
        <field name="name">Groups</field>
        <field name="parent_id" ref="g2p_registry_base.g2p_main_menu_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_enderase_groups')"/>
        <field name="sequence" eval="20"/>
        <field name="active" eval="False"/>
    </record>

    <record id="menu_enderase_registry_root" model="ir.ui.menu">
        <field name="name">Enderase Registry</field>
        <field name="active" eval="False"/>
    </record>
    <record id="menu_enderase_members" model="ir.ui.menu">
        <field name="name">Members</field>
        <field name="parent_id" ref="g2p_registry_base.g2p_main_menu_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_enderase_members')"/>
        <field name="active" eval="False"/>
    </record>
