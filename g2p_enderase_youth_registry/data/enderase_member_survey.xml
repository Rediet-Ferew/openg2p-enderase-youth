        <field name="question_type">simple_choice</field>
        <field name="g2p_odk_name">gender</field>
        <field name="g2p_odk_appearance">minimal</field>
        <field name="g2p_odk_choice_model">gender.type</field>
        <field name="g2p_odk_choice_value_field">value</field>
        <field name="g2p_odk_choice_label_field">code</field>
        <field name="enderase_member_field">gender</field>
    </record>

    <record id="q_nationality" model="survey.question">
