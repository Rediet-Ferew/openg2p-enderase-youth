<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Default survey that provisions an Enderase member on completion.

        The survey CONFIGURATION is the single source of truth: pushing it to ODK
        (g2p_survey) generates the XLSForm, and select questions pull their choices
        directly from the registry lookup models at push time (value = code,
        label = name), including the cascading Region -> Zone -> Woreda selects.
        Imported submissions map each node back onto the member by code.
    -->
    <record id="survey_enderase_member_registration" model="survey.survey">
        <field name="title">Enderase Youth Membership Registration</field>
        <field name="description"><![CDATA[<p>Register a new Enderase youth member. Completing this form (online or via ODK Collect) creates the member in the Enderase registry.</p>]]></field>
        <field name="access_mode">public</field>
        <field name="users_login_required" eval="False"/>
        <field name="questions_layout">one_page</field>
        <field name="enderase_creates_member" eval="True"/>
        <field name="g2p_odk_delivery_mode">both</field>
        <field name="g2p_odk_project_name">Enderase</field>
    </record>

    <!-- ===================== Personal information ===================== -->
    <record id="q_full_name" model="survey.question">
        <field name="survey_id" ref="survey_enderase_member_registration"/>
        <field name="sequence">10</field>
        <field name="title">Full Name</field>
        <field name="question_type">char_box</field>
        <field name="constr_mandatory" eval="True"/>
        <field name="g2p_odk_name">full_name</field>
        <field name="enderase_member_field">enderase_full_name</field>
    </record>

    <record id="q_fayda_national_id" model="survey.question">
        <field name="survey_id" ref="survey_enderase_member_registration"/>
        <field name="sequence">20</field>
