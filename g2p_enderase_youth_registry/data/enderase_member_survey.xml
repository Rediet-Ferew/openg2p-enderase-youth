        <field name="question_type">date</field>
        <field name="g2p_odk_name">date_of_birth</field>
        <field name="g2p_odk_constraint">. &lt;= today()</field>
        <field name="g2p_odk_constraint_message">Date of birth cannot be in the future.</field>
        <field name="enderase_member_field">date_of_birth</field>
    </record>

    <record id="q_gender" model="survey.question">
        <field name="survey_id" ref="survey_enderase_member_registration"/>
        <field name="sequence">40</field>
