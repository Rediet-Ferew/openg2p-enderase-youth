        <field name="question_type">char_box</field>
        <field name="validation_email" eval="True"/>
        <field name="g2p_odk_name">email_address</field>
        <field name="g2p_odk_constraint">regex(., '^[^@]+@[^@]+\.[^@]+$')</field>
