<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Action for Programs -->
  <record id="action_g2p_programs" model="ir.actions.act_window">
    <field name="name">Programs</field>
    <field name="res_model">g2p.program.definition</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Program Form View -->
  <record id="view_g2p_programs_form" model="ir.ui.view">
    <field name="name">g2p.programs.form</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <form string="G2P Programs">
        <sheet>
          <group>
            <group string="Program Information">
              <field name="id" invisible="1"/>
              <field name="program_mnemonic" readonly="not context.get('program_form_edit')"/>
              <field name="description" readonly="not context.get('program_form_edit')"/>
              <field name="program_status" readonly="not context.get('program_form_edit')"/>
            </group>
            <group string="Program Configuration">
              <field string="Base Registry" name="target_registry" readonly="not context.get('program_form_create')"/>
              <field name="service_providers_required" readonly="not context.get('program_form_create')"/>
              <field name="show_label_for_beneficiary_list" invisible="1"/>
            </group>
            <group string="Enrollment Configuration" >
              <field string="Frequency" name="enrollment_frequency" readonly="not context.get('program_form_edit')"/>
              <field string="# of Verifications" name="verifications_for_enrolment" readonly="not context.get('program_form_edit')"/>
              <field name="auto_approve_enrolment" readonly="not context.get('program_form_edit')"/>
            </group>
            <group string="Disbursement Configuration" >
              <field string="Frequency" name="disbursement_frequency" readonly="not context.get('program_form_edit')"/>
              <field string="# of Verifications" name="verifications_for_disbursement" readonly="not context.get('program_form_edit')"/>
              <field name="auto_approve_disbursement" readonly="not context.get('program_form_edit')"/>
            </group>
          </group>
          <notebook>
            <!-- Benefit Codes Page (Invisible) -->
            <page string="Benefit Codes" invisible="1">
              <field name="benefit_code_ids" nolabel="1" />
            </page>
            <!-- Program Benefit Codes Page -->
            <page string="Program Benefit Codes">
              <field name="program_benefit_code_ids" nolabel="1" options="{'no_quick_create': True}"/>
            </page>
            <!-- Eligibility Rules Page -->
            <page string="Eligibility Rules">
              <field name="eligibility_rule_ids" nolabel="1" options="{'no_quick_create': True}" context="{'default_program_id': id, 'default_target_registry': target_registry}"/>
            </page>
            <!-- Entitlement Rules Page -->
            <page string="Entitlement Rules">
              <field name="entitlement_rule_ids" nolabel="1" options="{'no_quick_create': True}" context="{'default_target_registry': target_registry, 'default_allowed_benefit_code_ids': benefit_code_ids}"/>
            </page>
            <!-- Enrollment Cycles Page -->
            <page string="Enrollment Cycles">
              <field name="enrollment_cycle_ids" no_label="0" context="{'default_program_id': id}" mode="tree" />
            </page>
            <!-- Disbursement Cycles Page -->
            <page string="Disbursement Cycles">
              <field name="disbursement_cycle_ids" nolabel="1"/>                
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Program Tree View (defined first so act_window.view refs resolve correctly) -->
  <record id="view_g2p_programs_tree" model="ir.ui.view">
    <field name="name">g2p.programs.tree</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <tree string="G2P Programs">
        <control>
          <create string="Add Program"/>
        </control>
        <field name="program_mnemonic" />
        <field name="description"/>
        <field name="target_registry"/>
        <field name="program_status"/>
        <button name="action_open_edit" type="object" class="fa fa-pencil" title="Edit" groups="g2p_pbms.group_program_editor"/>
      </tree>
    </field>
  </record>

  <!-- Program Tree View for Enrollment Cycles Menu -->
  <record id="view_g2p_programs_enrollment_tree" model="ir.ui.view">
    <field name="name">g2p.programs.enrollment.tree</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <tree string="Programs" create="0" delete="0" edit="0">
        <field name="program_mnemonic" string="Program Name"/>
        <field name="latest_enrollment_cycle" string="Latest Cycle"/>
        <button name="action_view_enrollment_cycles" type="object" string="View" class="oe_link"/>
      </tree>
    </field>
  </record>

  <!-- Program Configuration Form View -->
  <record id="view_g2p_programs_config_form" model="ir.ui.view">
    <field name="name">g2p.programs.config.form</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <form string="Program Configuration">
        <sheet>
          <group>
            <group string="Program Information">
              <field name="id" invisible="1"/>
              <field name="program_mnemonic" readonly="not context.get('program_form_edit')"/>
              <field name="description" readonly="not context.get('program_form_edit')"/>
              <field name="program_status" readonly="not context.get('program_form_edit')"/>
            </group>
            <group string="Program Configuration">
              <field string="Base Registry" name="target_registry" readonly="not context.get('program_form_create')"/>
              <field name="service_providers_required" readonly="not context.get('program_form_create')"/>
              <field name="show_label_for_beneficiary_list" invisible="1"/>
            </group>
            <group string="Enrollment Configuration">
              <field string="Frequency" name="enrollment_frequency" readonly="not context.get('program_form_edit')"/>
            </group>
            <group string="Disbursement Configuration">
              <field string="Frequency" name="disbursement_frequency" readonly="not context.get('program_form_edit')"/>
            </group>
          </group>
          <notebook>
            <!-- Benefit Codes Page (Invisible) -->
            <page string="Benefit Codes" invisible="1">
              <field name="benefit_code_ids" nolabel="1"/>
            </page>
            <!-- Program Benefit Codes Page -->
            <page string="Program Benefit Codes">
              <field name="program_benefit_code_ids" nolabel="1" options="{'no_quick_create': True}"/>
            </page>
            <!-- Eligibility Rules Page -->
            <page string="Eligibility Rules">
              <field name="eligibility_rule_ids" nolabel="1" options="{'no_quick_create': True}" context="{'default_program_id': id, 'default_target_registry': target_registry}"/>
            </page>
            <!-- Entitlement Rules Page -->
            <page string="Entitlement Rules">
              <field name="entitlement_rule_ids" nolabel="1" options="{'no_quick_create': True}" context="{'default_target_registry': target_registry, 'default_allowed_benefit_code_ids': benefit_code_ids}"/>
            </page>
            <!-- Enrolment Workflow Page -->
            <page string="Enrolment Workflow">
              <field name="enrollment_workflow_stage_ids" nolabel="1" context="{'default_program_id': id, 'default_cycle_type': 'ENROLMENT'}" options="{'no_quick_create': True}">
                <tree string="Enrolment Workflow Stages" default_order="stage_number">
                  <control>
                    <create string="Add New Stage"/>
                  </control>
                  <field name="cycle_type" column_invisible="1"/>
                  <field name="stage_number"/>
                  <field name="stage_name"/>
                  <field name="group_id" string="Approval Group"/>
                </tree>
              </field>
            </page>
            <!-- Disbursement Workflow Page -->
            <page string="Disbursement Workflow">
              <field name="disbursement_workflow_stage_ids" nolabel="1" context="{'default_program_id': id, 'default_cycle_type': 'DISBURSEMENT'}" options="{'no_quick_create': True}">
                <tree string="Disbursement Workflow Stages" default_order="stage_number">
                  <control>
                    <create string="Add New Stage"/>
                  </control>
                  <field name="cycle_type" column_invisible="1"/>
                  <field name="stage_number"/>
                  <field name="stage_name"/>
                  <field name="group_id" string="Approval Group"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Program Operations Form View (formerly Program Management) -->
  <record id="view_g2p_programs_management_form" model="ir.ui.view">
    <field name="name">g2p.programs.management.form</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <form string="Program Operations">
        <sheet>
          <field name="id" invisible="1"/>
          <notebook>
            <!-- Enrollment Cycles Page -->
            <page string="Enrollment Cycles">
              <field name="enrollment_cycle_ids" no_label="0" context="{'default_program_id': id}" mode="tree"/>
            </page>
            <!-- Disbursement Cycles Page -->
            <page string="Disbursement Cycles">
              <field name="disbursement_cycle_ids" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action for Program Configuration -->
  <record id="action_g2p_programs_config" model="ir.actions.act_window">
    <field name="name">Program Configuration</field>
    <field name="res_model">g2p.program.definition</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'program_view_mode': 'config'}</field>
  </record>
  <record id="action_g2p_programs_config_tree" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_config"/>
    <field name="view_id" ref="view_g2p_programs_tree"/>
    <field name="view_mode">tree</field>
    <field name="sequence">1</field>
  </record>
  <record id="action_g2p_programs_config_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_config"/>
    <field name="view_id" ref="view_g2p_programs_config_form"/>
    <field name="view_mode">form</field>
    <field name="sequence">2</field>
  </record>

  <!-- Action for Program Operations -->
  <record id="action_g2p_programs_management" model="ir.actions.act_window">
    <field name="name">Program Operations</field>
    <field name="res_model">g2p.program.definition</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'program_view_mode': 'management'}</field>
  </record>
  <record id="action_g2p_programs_management_tree" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_management"/>
    <field name="view_id" ref="view_g2p_programs_tree"/>
    <field name="view_mode">tree</field>
    <field name="sequence">1</field>
  </record>
  <record id="action_g2p_programs_management_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_management"/>
    <field name="view_id" ref="view_g2p_programs_management_form"/>
    <field name="view_mode">form</field>
    <field name="sequence">2</field>
  </record>

  <!-- ============================================================
       Enrolment Cycles navigation: Program list -> Cycle list
  ============================================================ -->

  <!-- Program list: just name, opens enrolment cycles form -->
  <record id="view_g2p_programs_enrolment_cycles_tree" model="ir.ui.view">
    <field name="name">g2p.programs.enrolment.cycles.tree</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <tree string="Programs" create="0" delete="0" edit="0">
        <field name="program_mnemonic" string="Program Name"/>
        <field name="latest_ec_cycle_name" string="Current Cycle"/>
        <field name="latest_ec_version" string="Current List #"/>
        <field name="latest_ec_stage" string="Current Stage"/>
        <field name="latest_ec_status" string="Current Status" widget="badge"
               decoration-success="latest_ec_status == 'APPROVED'"
               decoration-danger="latest_ec_status == 'REJECTED'"
               decoration-warning="latest_ec_status == 'PENDING'"/>
        <field name="enrollment_frequency" string="Cycle Frequency"/>
        <field name="latest_ec_creation_date" string="Cycle Created On"/>
        <field name="latest_enrollment_cycle_id" column_invisible="1"/>
        <button name="action_view_enrollment_cycles" type="object" string="View" class="oe_link"/>
        <button name="action_open_create_cycle_wizard" type="object" string="Create New Cycle" class="btn-primary"
                invisible="latest_enrollment_cycle_id and latest_ec_status not in ('APPROVED', 'REJECTED')"/>
      </tree>
    </field>
  </record>

  <!-- Program "form" that shows only that program's enrolment cycles -->
  <record id="view_g2p_program_enrolment_cycles_form" model="ir.ui.view">
    <field name="name">g2p.program.enrolment.cycles.form</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <form create="0" delete="0" edit="0" string="Enrolment Cycles">
        <sheet>
          <field name="enrollment_cycle_ids" nolabel="1">
            <tree default_order="cycle_number desc" delete="false" create="false" edit="false"
                  decoration-muted="not is_current_cycle">
              <field name="is_current_cycle" column_invisible="1"/>
              <field name="cycle_mnemonic" string="Cycle"/>
              <field name="list_count_display" string="# Lists"/>
              <field name="wip_stage_name" string="Current Stage"/>
              <button name="action_open_view" type="object" string="View" class="oe_link"/>
            </tree>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action: Enrolment Cycles entry point (opens program list) -->
  <record id="action_g2p_programs_enrolment_cycles" model="ir.actions.act_window">
    <field name="name">Enrolment Cycles</field>
    <field name="res_model">g2p.program.definition</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_g2p_programs_enrolment_cycles_tree_view" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_enrolment_cycles"/>
    <field name="view_id" ref="view_g2p_programs_enrolment_cycles_tree"/>
    <field name="view_mode">tree</field>
    <field name="sequence">1</field>
  </record>
  <record id="action_g2p_programs_enrolment_cycles_form_view" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_enrolment_cycles"/>
    <field name="view_id" ref="view_g2p_program_enrolment_cycles_form"/>
    <field name="view_mode">form</field>
    <field name="sequence">2</field>
  </record>

  <!-- ============================================================
       Disbursement Cycles navigation: Program list -> Cycle list
  ============================================================ -->

  <record id="view_g2p_programs_disbursement_cycles_tree" model="ir.ui.view">
    <field name="name">g2p.programs.disbursement.cycles.tree</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <tree string="Programs" create="0" delete="0" edit="0">
        <field name="program_mnemonic" string="Program Name"/>
        <field name="latest_dc_cycle_name" string="Current Cycle"/>
        <field name="latest_dc_version" string="Current List #"/>
        <field name="latest_dc_stage" string="Current Stage"/>
        <field name="latest_dc_status" string="Current Status" widget="badge"
               decoration-success="latest_dc_status == 'APPROVED'"
               decoration-danger="latest_dc_status == 'REJECTED'"
               decoration-warning="latest_dc_status == 'PENDING'"/>
        <field name="latest_disbursement_cycle_id" column_invisible="1"/>
        <button name="action_view_disbursement_cycles" type="object" string="View" class="oe_link"/>
        <button name="action_open_create_disbursement_cycle_wizard" type="object" string="Create New Cycle" class="btn-primary"
                invisible="latest_disbursement_cycle_id and latest_dc_status not in ('APPROVED', 'REJECTED')"/>
      </tree>
    </field>
  </record>

  <!-- Program "form" that shows only that program's disbursement cycles -->
  <record id="view_g2p_program_disbursement_cycles_form" model="ir.ui.view">
    <field name="name">g2p.program.disbursement.cycles.form</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <form create="0" delete="0" edit="0" string="Disbursement Cycles">
        <sheet>
          <field name="disbursement_cycle_ids" nolabel="1">
            <tree default_order="cycle_number desc" delete="false" create="false" edit="false"
                  decoration-muted="not is_current_cycle">
              <field name="is_current_cycle" column_invisible="1"/>
              <field name="cycle_mnemonic" string="Cycle"/>
              <field name="list_count_display" string="# Lists"/>
              <field name="wip_stage_name" string="Current Stage"/>
              <button name="action_open_view" type="object" string="View" class="oe_link"/>
            </tree>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action: Disbursement Cycles entry point (opens program list) -->
  <record id="action_g2p_programs_disbursement_cycles" model="ir.actions.act_window">
    <field name="name">Disbursement Cycles</field>
    <field name="res_model">g2p.program.definition</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_g2p_programs_disbursement_cycles_tree_view" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_disbursement_cycles"/>
    <field name="view_id" ref="view_g2p_programs_disbursement_cycles_tree"/>
    <field name="view_mode">tree</field>
    <field name="sequence">1</field>
  </record>
  <record id="action_g2p_programs_disbursement_cycles_form_view" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_disbursement_cycles"/>
    <field name="view_id" ref="view_g2p_program_disbursement_cycles_form"/>
    <field name="view_mode">form</field>
    <field name="sequence">2</field>
  </record>

  <!-- Action for Programs in Enrollment Cycles Menu -->
  <record id="action_g2p_programs_enrollment" model="ir.actions.act_window">
    <field name="name">Programs</field>
    <field name="res_model">g2p.program.definition</field>
    <field name="view_mode">tree</field>
    <field name="view_id" ref="view_g2p_programs_enrollment_tree"/>
    <field name="context">{'create': False}</field>
  </record>

</odoo>
