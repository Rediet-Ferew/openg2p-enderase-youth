<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_enrollment_cycle_create_wizard_form" model="ir.ui.view">
        <field name="name">g2p.enrollment.cycle.create.wizard.form</field>
        <field name="model">g2p.enrollment.cycle.create.wizard</field>
        <field name="arch" type="xml">
            <form string="New Enrolment Cycle">
                <group>
                    <field name="program_id" readonly="1"/>
                    <field name="cycle_name"/>
                    <field name="cycle_number" readonly="1"/>
                    <field name="creation_date" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Create" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
