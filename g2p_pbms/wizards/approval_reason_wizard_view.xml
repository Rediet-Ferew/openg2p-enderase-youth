<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_approval_reason_wizard_form" model="ir.ui.view">
        <field name="name">g2p.approval.reason.wizard.form</field>
        <field name="model">g2p.approval.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason">
                <group>
                    <field name="pending_stage_id" invisible="1"/>
                    <field name="action_type" invisible="1"/>
                    <field name="reason" required="1" placeholder="Please provide a reason..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
